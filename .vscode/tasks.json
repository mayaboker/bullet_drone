{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run altitude hold",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "--all-packages",
                "--all-extras",
                "--all-groups",
                "python",
                "-m",
                "examples.altitude_hold.main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
