                "clear": true
            }
        },
        {
            "label": "Run Godot viewer",
            "type": "process",
            "command": "godot",
            "args": [
                "--path",
                "renderers/godot"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "__NV_PRIME_RENDER_OFFLOAD": "1",
                    "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
