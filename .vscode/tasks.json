{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run basic simulation",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "bullet-drone",
                "--config",
                "configs/basic.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run hover simulation",
            "type": "process",
            "command": "uv",
