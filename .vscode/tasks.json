{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run basic simulation",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "bullet-drone",
                "--config",
                "configs/basic.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run hover simulation",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "examples/hover/main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run Godot viewer",
            "type": "process",
            "command": "godot",
            "args": [
                "--path",
                "renderers/godot"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run drone with Godot",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "examples/hover/main.py",
                "--renderer",
                "godot",
                "--render-config",
                "configs/render-godot.yaml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run Godot and drone",
            "dependsOn": [
                "Run Godot viewer",
                "Run drone with Godot"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Run drone 1 with Godot",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "examples/hover/main.py",
                "--renderer",
                "godot",
                "--render-config",
                "configs/render-godot.yaml",
                "--initial-position",
                "0",
                "0",
                "0.015"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run drone 2 with Godot",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "examples/hover/main.py",
                "--renderer",
                "godot",
                "--render-config",
                "configs/render-godot-drone-2.yaml",
                "--initial-position",
                "1.5",
                "0.25",
                "0.015"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run drone 3 with Godot",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "examples/hover/main.py",
                "--renderer",
                "godot",
                "--render-config",
                "configs/render-godot-drone-3.yaml",
                "--initial-position",
                "3",
                "0.5",
                "0.015"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run Godot and 3 drones",
            "dependsOn": [
                "Run Godot viewer",
                "Run drone 1 with Godot",
                "Run drone 2 with Godot",
                "Run drone 3 with Godot"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
